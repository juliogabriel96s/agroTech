# Alertas de Produtor Rural (WhatsApp)
PRODUTOR_TELEFONE="5519999998888"
WHATSAPP_API_URL="https://api.whatsapp-gateway.local/v1/messages"
WHATSAPP_API_TOKEN="token_secreto_whatsapp"
