generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeituraSensor {
  id            String   @id @default(uuid())
  fazenda       String
  setor         String
  temperaturaAr Float    @map("temperatura_ar")
  umidadeAr     Float    @map("umidade_ar")
  umidadeSolo   Int      @map("umidade_solo")
  recebidoEm    DateTime @default(now()) @map("recebido_em")

  @@map("leituras_sensores")
}
